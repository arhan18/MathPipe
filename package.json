    "test": "turbo run test",
    "test:schema-gate": "turbo run test --filter=@mathpipe/document-model",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
