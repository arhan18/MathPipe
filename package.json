{
  "name": "math-pdf-to-word",
  "version": "0.1.0",
  "private": true,
  "description": "Math-first PDF to editable Word SaaS — monorepo root",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
