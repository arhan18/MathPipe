# Copy to apps/web/.env — NEVER commit real values. See architecture §54.
# Generate project keys in the Supabase dashboard (Settings → API).
# Production secret values belong in Worker secrets (`wrangler secret put`),
# never in a file that the build reads.

# Public (safe for browser, inlined at build)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Canonical public URL; drives canonicals, robots.txt and sitemap.xml.
NEXT_PUBLIC_APP_URL=https://mathpipe.arhanahmad.com

# Server-only (Worker secrets in production)
SUPABASE_SERVICE_ROLE_KEY=
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
AI_PROVIDER_PRIMARY_API_KEY=
AI_PROVIDER_SECONDARY_API_KEY=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
RUNPOD_API_KEY=
SENTRY_DSN=
